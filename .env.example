# ---------------------------------------------------------------------------
# ControlPlane.ai — example environment configuration
# Copy to `.env`. Every value below has a safe default; the core prototype
# and the full demo run with NO changes and NO paid API keys.
# ---------------------------------------------------------------------------

# Provider used by the OPTIONAL LLM-as-judge evaluator.
#   mock   -> deterministic local judge (default, no network)
#   openai -> OpenAI-compatible endpoint (requires OPENAI_API_KEY)
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_JUDGE_MODEL=gpt-4o-mini

# When true, the dashboard exposes one-click curated demo scenarios.
# The real risk engine still processes them end to end — nothing is faked.
DEMO_MODE=true

# Privacy: when false (default), persisted trace/decision records store REDACTED
# request/response text (email/phone/card/secret masked). Detected entity
# types/counts are always kept for audit. Live API responses to the immediate
# caller are unaffected. Set true only for a deployment with its own retention
# controls.
CONTROLPLANE_STORE_RAW=false

# SQLite database location (relative to backend/).
CONTROLPLANE_DB_URL=sqlite:///./controlplane.db

# API server
CONTROLPLANE_HOST=0.0.0.0
CONTROLPLANE_PORT=8000

# Frontend -> backend base URL (used by Vite dev server / Docker)
VITE_API_BASE_URL=http://localhost:8000

# Deterministic seed for synthetic data / benchmarks (reproducible results).
CONTROLPLANE_SEED=1729

# Directory that holds versioned policy + workflow YAML.
CONTROLPLANE_CONFIG_DIR=../config
